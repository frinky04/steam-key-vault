# Postgres connection string (Railway injects this when you attach a Postgres service)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/steamkeys

# First-run setup code, and afterwards the break-glass recovery password.
# Not a normal login: accounts are created at /setup and via invites.
ADMIN_PASSWORD=change-me

# Generate both with: pnpm gen-secrets
SESSION_SECRET=
MASTER_KEY=

# Public base URL, used to build claim/invite links (defaults to Railway's domain / request host)
# APP_URL=https://keys.example.com

# Optional branding for link previews
# SENDER_NAME=Your Studio
# SITE_NAME=keys.example.com

# Optional Discord feed (claim / bad-key / send / low-stock events)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_EVENTS=claim,report,stock      # add "send" to also post when links are created
# LOW_STOCK_THRESHOLD=5
